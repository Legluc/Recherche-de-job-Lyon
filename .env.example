# --- France Travail (https://francetravail.io) ---
# Souscrire à l'API "Offres d'emploi v2" puis récupérer les identifiants de l'application.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Notion ---
# Créer une intégration interne (https://www.notion.so/my-integrations), copier le token,
# puis partager la base "Offres" avec cette intégration (menu ••• > Connexions).
NOTION_TOKEN=
# Base "Offres" (Lyon)
NOTION_DATABASE_ID=00d27d0a42ac4121b51571a7e1d706b0

# --- Optionnel ---
# Plafond d'insertions par run (défaut 20), réparti entre dev et alimentaire.
MAX_INSERT=30

# --- France Travail (https://francetravail.io) ---
# Souscrire à l'API "Offres d'emploi v2" puis récupérer les identifiants de l'application.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Notion ---
# Créer une intégration interne (https://www.notion.so/my-integrations), copier le token,
# puis partager la base "Offres" avec cette intégration (menu ••• > Connexions).
NOTION_TOKEN=
# Base "Offres" (Lyon)
NOTION_DATABASE_ID=00d27d0a42ac4121b51571a7e1d706b0

# --- Optionnel ---
# Plafond d'insertions du run automatique (défaut 20 dans LIMITS, 30 sur le workflow).
MAX_INSERT=30
# Passe navigateur (npm run select-web) : plafond et seuil propres à ce vivier.
# Le seuil y est relevé au-dessus de LIMITS.minScore (80), les cartes Indeed/WTTJ
# publiant rarement de quoi déclencher les bonus de conditions.
WEB_CAP=20
WEB_MIN_SCORE=84
